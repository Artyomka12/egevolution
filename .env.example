# Скопируйте этот файл в .env и заполните значения
# cp .env.example .env

# Секретный ключ Flask для подписи сессий.
# Сгенерируйте случайную строку: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Пароль для регистрации новых пользователей на сайте.
SITE_PASSWORD=

# Учётные данные администратора (используются только при первом запуске на чистой БД).
# После создания администратора эти переменные влияют только на новые деплои.
ADMIN_USERNAME=
ADMIN_PASSWORD=
