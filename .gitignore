# Видео
*.mp4
*.avi
*.mov
*.mkv

# База данных
users.db
users.db-*
.local-backups/
.local-data/
data/thematic/media/
data/tests/media/

# Python
__pycache__/
*.pyc
*.pyo

# Переменные окружения
.env
.env.save*

# Server-specific Passenger configuration and restart files
/passenger_wsgi.py
/tmp/

# Загруженные файлы
static/uploads/*
!static/uploads/.gitkeep

# IDE
.vscode/
.idea/

# Claude Code — личные настройки, не для команды
.claude/settings.local.json

# Temporary prototype testing files
prototypes/**/.browser-profile/
prototypes/**/.qa/

# Private local runtime metadata and worker lock
/data/ege-renumber-2026.json
/.local-worker-*.lock

# Private cross-file transaction journal and process lock (never curriculum).
.content-runtime/
thematic_variants/**/*.tmp
tests_content/**/*.tmp
